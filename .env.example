# Copia este archivo como .env para cambiar puertos o credenciales. Sin .env, docker-compose.yml usa
# valores de DESARROLLO. Nunca subas .env al repositorio.

# SQL Server (contraseña: 8+ caracteres con mayúscula, minúscula, número y símbolo)
MSSQL_SA_PASSWORD=FinCore_Sa_2026!
DB_APP_USER=fincore_app
DB_APP_PASSWORD=Dev#Api_Segura_2026
# Login de Reporting Services (solo EXECUTE en el esquema rpt)
DB_REPORTS_USER=fincore_reports
DB_REPORTS_PASSWORD=Dev#Informes_2026

# Firma de los JWT: al menos 32 caracteres aleatorios
JWT_SIGNING_KEY=cambia-esta-clave-por-una-aleatoria-de-32-o-mas

# Puertos en el equipo (elegidos para no chocar con SQL Server local 1433 ni con otros proyectos)
DB_PORT=14333
API_PORT=5080
WEB_PORT=4300
