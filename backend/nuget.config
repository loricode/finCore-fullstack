<?xml version="1.0" encoding="utf-8"?>
<!-- Fuentes de paquetes del repositorio: solo nuget.org. Evita depender de feeds configurados en cada equipo
     y hace que el build en Docker sea igual al local. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
