{
  "ConnectionStrings": {
    "FinCore": ""
  },
  "Jwt": {
    "Issuer": "fincore-api",
    "Audience": "fincore-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "LoginPerMinute": 20
  },
  "Api": {
    "ExposeDocs": false
  },
  "Logging": {
    "Json": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.EntityFrameworkCore.Query": "Fatal",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
