{
  "ConnectionStrings": {
    "FinCore": "",
    "LegacyBank": ""
  },
  "Jwt": {
    "SigningKey": "el-worker-no-emite-tokens-pero-la-infraestructura-valida-la-opcion"
  },
  "Worker": {
    "ServiceUser": "svc.integration",
    "Jobs": {
      "LegacyBankImport": { "Enabled": true, "IntervalSeconds": 300, "RunOnStartup": true },
      "InboundEventRecovery": { "Enabled": true, "IntervalSeconds": 60 },
      "NightlyReconciliation": { "Enabled": true, "DailyAt": "02:00", "DaysBack": 1 },
      "StagingPurge": { "Enabled": true, "DailyAt": "03:00", "RetentionDays": 30 }
    }
  },
  "Logging": {
    "Json": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
